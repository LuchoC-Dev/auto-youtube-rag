# Local configuration and secrets
.env
.env.*
!.env.example

# Local model weights and runtime caches
.cache/
node_modules/
dist/
coverage/

# Generated benchmark runs; keep only reviewed baselines
benchmarks/embeddings/results/*
!benchmarks/embeddings/results/baseline.json
!benchmarks/embeddings/results/baseline.md
benchmarks/vector-search/results/*
!benchmarks/vector-search/results/baseline.json
!benchmarks/vector-search/results/baseline.md

# Generated eval bundles; they carry verbatim third-party video text and
# can't be redistributed under the repo's MIT license. Keep the closing
# reports and the Layer B judgments, which are the project's own evidence.
evals/results/*/*/*/context.md
evals/results/*/*/*/result.json

# Local databases and generated indexes
*.db
*.db-*
*.sqlite
*.sqlite3

# Runtime caches
__pycache__/
*.py[cod]
.cache/
.pytest_cache/

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
